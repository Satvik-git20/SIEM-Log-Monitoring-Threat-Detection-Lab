# =============================================================================
# SOC-Lab - Docker Compose environment template
# TEMPLATE ONLY. Contains no real secrets. Copy to .env and fill in.
#
#   cd docker
#   cp .env.example .env
#
# docker/compose.yml is executed with --env-file .env (or by default reads .env
# from the same directory as the compose file), so this file supplies every
# value the compose file interpolates.
# =============================================================================

# --- Stack version -----------------------------------------------------------
# Verified GA release. Change only together with the image tags you re-verify.
STACK_VERSION=9.5.3

# --- Required secret ---------------------------------------------------------
# Used by Elasticsearch (ELASTIC_PASSWORD), Kibana (ELASTICSEARCH_PASSWORD),
# Fleet Server (FLEET_SERVER_ELASTICSEARCH_PASSWORD, KIBANA_FLEET_PASSWORD).
# Generate with: pwsh -File ../scripts/setup/New-LabSecrets.ps1
ELASTIC_PASSWORD=CHANGE_ME_generate_a_strong_local_password

# --- Cluster -----------------------------------------------------------------
ES_CLUSTER_NAME=soc-lab-cluster
# Loopback only. Do not change to 0.0.0.0 on a shared/university network:
# that exposes an unauthenticated-TLS ES with a known-superuser password.
ES_BIND_ADDRESS=127.0.0.1
KIBANA_BIND_ADDRESS=127.0.0.1
FLEET_SERVER_HOST=127.0.0.1
FLEET_SERVER_PORT=8220

# --- Heap --------------------------------------------------------------------
# The lab host has 15.3 GB RAM shared with Windows and WSL2. 1 GB keeps the
# Windows endpoint responsive; raise to 2g only if you raise the container
# memory limit in compose.yml to match.
# NOTE: in compose.yml the heap is set on the container command line /
# via ES_JAVA_OPTS, not here. This value is consumed by the native
# install path (elastic/config-templates). Kept for a single source of truth.
ES_JVM_HEAP=1g

# --- Kibana credentials (Docker path) -----------------------------------------
# Used by docker/kibana.yml (mounted into the Kibana container). These are NOT
# used by the native path (see New-LabSecrets.ps1 / Install-ElasticStack.ps1).
# Generate with: pwsh -File scripts/setup/New-LabSecrets.ps1
# KIBANA_SERVICE_TOKEN is a service-account token (created via ES Service
# Accounts API). KIBANA_ENCRYPTION_KEY is xpack.encryptedSavedObjects.encryptionKey
# and MUST be >= 32 chars; it is required for Fleet setup to complete in 9.x.
KIBANA_SERVICE_TOKEN=CHANGE_ME_generated_secret_account_token
KIBANA_ENCRYPTION_KEY=CHANGE_ME_at_least_32_characters_generated_secret
WIN_SOC01_HOSTNAME=WIN-SOC01
LINUX_SOC01_HOSTNAME=LINUX-SOC01
LAB_USER=soclab
LAB_USER_WRONG_PASSWORD=SIEM-LAB-DELIBERATELY-WRONG-PASSWORD
