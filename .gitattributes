# Normalise line endings for cross-platform contributors.
# Detection rule NDJSON must stay LF so Kibana import is byte-stable.
* text=auto

*.ps1        text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf
*.sh         text eol=lf
*.py         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.xml        text eol=lf
*.ndjson     text eol=lf
*.md         text eol=lf
*.conf       text eol=lf

# Binary assets
*.png        binary
*.jpg        binary
*.gif        binary
*.ico        binary
*.zip        binary
*.gz         binary
*.exe        binary
*.sys        binary
