# =============================================================================
# SOC-Lab: SIEM Log Monitoring & Threat Detection Platform
# TEMPLATE ONLY - contains no real secrets.
#
# Usage:
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#   .env is gitignored. NEVER commit .env.
#
# Generate real values:  pwsh -File scripts/setup/New-LabSecrets.ps1
# =============================================================================

# --- Stack identity ----------------------------------------------------------
STACK_VERSION=9.5.3
# Elastic Stack runs on the Windows lab host (see architecture/deviations.md)
LAB_MODE=host-as-windows-endpoint

# --- Elasticsearch / Kibana credentials -------------------------------------
# Password for the built-in `elastic` superuser. Set in elasticsearch.yml as
# ELASTIC_PASSWORD and read by Kibana. Local lab only, loopback-bound.
ELASTIC_PASSWORD=CHANGE_ME_elastic_superuser_password
# Dedicated Kibana -> Elasticsearch credential (preferred over reusing `elastic`)
KIBANA_ES_PASSWORD=CHANGE_ME_kibana_system_password
# Password for the ES service account token owner (used by setup scripts)
KIBANA_SYSTEM_USER=kibana_system

# --- Bind addresses ----------------------------------------------------------
# Security posture: lab services listen on loopback ONLY. Do not set 0.0.0.0
# on a shared or university network. See docs/configuration.md#network-binding
ES_BIND_ADDRESS=127.0.0.1
KIBANA_BIND_ADDRESS=127.0.0.1
FLEET_SERVER_HOST=127.0.0.1
FLEET_SERVER_PORT=8220

# --- Cluster sizing ----------------------------------------------------------
# Host has 15.3 GB RAM shared with WSL2 and Windows. 1 GB heap is the documented
# lab default; raise to 2g only if ingest/queries are slow and nothing else
# needs the memory. See docs/troubleshooting.md#outofmemory
ES_JVM_HEAP=1g
ES_CLUSTER_NAME=soc-lab-cluster
ES_DATA_PATH=C:/elastic/elasticsearch-9.5.3/data

# --- Fleet / agent enrollment ------------------------------------------------
# Generated by Kibana (Fleet > Agent policies > Add agent) or by
# scripts/setup/New-FleetEnrollmentToken.ps1. Short-lived but still a secret.
FLEET_ENROLLMENT_TOKEN=CHANGE_ME_fleet_enrollment_token

# --- Lab endpoints -----------------------------------------------------------
WIN_SOC01_HOSTNAME=WIN-SOC01
LINUX_SOC01_HOSTNAME=LINUX-SOC01
# Lab simulation source identity (dedicated throwaway lab account only)
LAB_USER=soclab
LAB_USER_WRONG_PASSWORD=SIEM-LAB-DELIBERATELY-WRONG-PASSWORD

# --- Attack simulation switches ---------------------------------------------
# Safety interlocks. All simulations are local, benign and non-destructive.
SIM_ALLOW_WINDOWS_BRUNEFORCE=true
SIM_ALLOW_LINUX_SSH_BRUNEFORCE=true
SIM_ALLOW_POWERSHELL_MISUSE=true
SIM_ALLOW_AUTH_CORRELATION=true
SIM_FAILURE_COUNT=6
SIM_WINDOW_MINUTES=5
